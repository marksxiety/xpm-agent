{
  "name": "xpm-agent",
  "version": "0.0.4",
  "scripts": {
    "test": "bun test src/tests/",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "bun build --target bun --minify-whitespace --minify-syntax --outdir ./dist src/index.ts",
    "start": "bun run build && pm2 startOrReload ecosystem.config.js --env production && pm2 save"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "^1.4.29",
    "pm2": "^7.0.3",
    "pm2-windows-startup": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bun-types": "latest",
    "eslint": "^10.9.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "module": "src/index.js"
}
