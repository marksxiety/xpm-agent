SERVER_PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Required. The agent refuses to boot without a bearer token because /pm2/start
# can execute arbitrary code. Generate one, e.g.: openssl rand -hex 32
AUTH_TOKEN=

# Local-development escape hatch only: boots the agent with no authentication
# and logs a warning on every start. Never enable this on a reachable host.
# ALLOW_INSECURE=true

# Optional allowlist of absolute app roots. When set, cwd must live under one.
# APP_ROOTS=C:\apps,/srv/apps
