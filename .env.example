SERVER_PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Optional bearer token. When set, every /pm2/* request must send
# `Authorization: Bearer <AUTH_TOKEN>`. Recommended whenever the port is
# reachable beyond localhost — /pm2/start executes code by design.
AUTH_TOKEN=

# Optional allowlist of absolute app roots. When set, cwd must live under one.
# APP_ROOTS=C:\apps,/srv/apps

# Optional allowlist of absolute directories an interpreter executable must
# live under. When set, `interpreter` on /start must live under one of them.
# INTERPRETER_ROOTS=C:\Program Files\nodejs,/usr/bin

# Optional allowlist of interpreter flags, as JSON, keyed by the interpreter
# executable's base name (without .exe). Until an interpreter is listed here,
# /start rejects any `interpreter_args` for it. Rule kinds: exact (token),
# pattern (regex), path (value must resolve inside cwd).
# INTERPRETER_FLAGS={"node":[{"kind":"pattern","pattern":"^--max-old-space-size=\\d+$"},{"kind":"path","flag":"--env-file"}],"python":[{"kind":"exact","flag":"-u"},{"kind":"exact","flag":"-B"}]}
